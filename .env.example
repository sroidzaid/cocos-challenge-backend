# Copy to .env (git-ignored) and adjust. Never commit real credentials.

# --- Profile "local" (default). Defaults below match the documented docker command. ---
LOCAL_DB_URL=jdbc:postgresql://localhost:5432/cocos
LOCAL_DB_USERNAME=cocos
LOCAL_DB_PASSWORD=cocos

# --- Profile "cocos" (external database provided by Cocos). No defaults: all three are required. ---
# The URL must not contain credentials (no user:password@ and no password= parameter).
# COCOS_DB_URL=jdbc:postgresql://<host>:<port>/<database>
# COCOS_DB_USERNAME=<username>
# COCOS_DB_PASSWORD=<password>
# Read-only by default. Set to false only once writes have been authorised.
# COCOS_DB_READ_ONLY=true

# --- Optional, any profile ---
# SPRING_PROFILES_ACTIVE=local
# DB_POOL_SIZE=10
# SERVER_PORT=8080
# APP_TIME_ZONE=America/Argentina/Buenos_Aires
# APP_ACCOUNT_LOCK_TIMEOUT=3s
