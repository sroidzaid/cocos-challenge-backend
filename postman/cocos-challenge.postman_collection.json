{
  "info": {
    "name": "Cocos Challenge Backend",
    "_postman_id": "6d2f1c7e-4b8a-4f3e-9c1d-2a7b5e8f0c13",
    "description": "Requests to try the API of cocos-challenge-backend.\n\nUsage:\n- Import this file in Postman (File > Import). Set `baseUrl` if the app does not run on http://localhost:8080.\n- The expected values in the tests are those of the original seed (database.sql + V2). Run the folders in order with the Collection Runner against a freshly initialised local database: orders change the account, so a second run starts from a different state.\n- POST /orders requires an `Idempotency-Key` (UUID). The collection pre-request script generates a new one per request (`{{requestKey}}`); the Idempotency folder reuses a fixed `{{idempotencyKey}}` on purpose.\n- Cash transfers (CASH_IN / CASH_OUT) are in a subfolder of Orders - create. Their checks compare the portfolio before and after each request, so they do not depend on the seed figures.\n- Profile `cocos`: the external database is read-only by default, so every POST fails (the database rejects writes); only Health, Instruments and Portfolio apply, and their values depend on that database's data.\n- No credentials here: the application is the one that connects to the database. Swagger UI: {{baseUrl}}/swagger-ui.html",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "userId", "value": "1" },
    { "key": "instrumentId", "value": "47", "description": "PAMP (Pampa Holding S.A.)" },
    { "key": "idempotencyKey", "value": "" },
    { "key": "orderId", "value": "" },
    { "key": "limitOrderId", "value": "" },
    { "key": "transferKey", "value": "", "description": "Idempotency-Key shared by a transfer and its retry (set by the scripts)" },
    { "key": "transferOrderId", "value": "", "description": "Id of the last transfer created (set by the scripts)" },
    { "key": "cashBefore", "value": "", "description": "cashBalance before the current transfer request (set by the scripts)" },
    { "key": "availableCashBefore", "value": "", "description": "availableCash before the current transfer request (set by the scripts)" },
    { "key": "expectedCashDelta", "value": "", "description": "Cash movement the current transfer request must produce (set by the scripts)" },
    { "key": "cashOutTooMuch", "value": "", "description": "availableCash + 1, for the rejected CASH_OUT (set by the scripts)" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
