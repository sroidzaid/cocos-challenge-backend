        {
          "name": "Cash transfers CASH_IN / CASH_OUT (run in order)",
          "description": "Transfers go through the same POST /orders with only `side` and `amount` (whole pesos). They are stored as orders on the ARS instrument with size = amount, price = 1, type MARKET.\n\nRun the six requests in order: each retry reuses the `{{transferKey}}` and `{{transferOrderId}}` of the request before it, and the CASH_OUT of 3,000 is covered by the CASH_IN of 5,000 just before it.\n\nThe checks are relative to the current state, so they also pass on a database that is not fresh. The folder scripts read the portfolio before and after every request. The cash (`cashBalance` and `availableCash`) must move by exactly the `expectedCashDelta` each request declares: +5,000, -3,000, or 0 for replays, conflicts and rejections. A full run leaves user {{userId}} with 2,000 more pesos.",
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
              "// Snapshot of the cash before the request; each request declares its expectedCashDelta afterwards.",
              "pm.collectionVariables.unset('expectedCashDelta');",
              "pm.sendRequest(pm.variables.replaceIn('{{baseUrl}}/api/v1/users/{{userId}}/portfolio'), (err, res) => {",
              "  if (err || res.code !== 200) { throw new Error('Could not read the portfolio before the request'); }",
              "  const portfolio = res.json();",
              "  pm.collectionVariables.set('cashBefore', String(portfolio.cashBalance));",
              "  pm.collectionVariables.set('availableCashBefore', String(portfolio.availableCash));",
              "});"
            ] } },
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "// Cash after the request versus the snapshot, compared in cents to avoid floating point noise.",
              "const expected = Number(pm.collectionVariables.get('expectedCashDelta'));",
              "const cents = value => Math.round(Number(value) * 100);",
              "pm.sendRequest(pm.variables.replaceIn('{{baseUrl}}/api/v1/users/{{userId}}/portfolio'), (err, res) => {",
              "  pm.test('cash moved by exactly ' + expected + ' (cashBalance and availableCash)', () => {",
              "    pm.expect(err).to.eql(null);",
              "    pm.expect(Number.isFinite(expected), 'the request must declare expectedCashDelta').to.be.true;",
              "    const portfolio = res.json();",
              "    pm.expect(cents(portfolio.cashBalance) - cents(pm.collectionVariables.get('cashBefore'))).to.eql(expected * 100);",
              "    pm.expect(cents(portfolio.availableCash) - cents(pm.collectionVariables.get('availableCashBefore'))).to.eql(expected * 100);",
              "  });",
              "});"
            ] } }
          ],
          "item": [
            {
              "name": "CASH_IN 5000 -> FILLED (credits the cash)",
              "event": [
                { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
                  "pm.collectionVariables.set('transferKey', pm.variables.replaceIn('{{$guid}}'));",
                  "pm.collectionVariables.set('expectedCashDelta', '5000');"
                ] } },
                { "listen": "test", "script": { "type": "text/javascript", "exec": [
                  "const body = pm.response.json();",
                  "pm.test('201 FILLED, not a replay', () => {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(body.status).to.eql('FILLED');",
                  "  pm.expect(pm.response.headers.has('Idempotent-Replayed')).to.be.false;",
                  "});",
                  "pm.test('stored on ARS with size = amount, price = 1, MARKET', () => {",
                  "  pm.expect(body.id).to.be.a('number');",
                  "  pm.expect(body.userId).to.eql(Number(pm.collectionVariables.get('userId')));",
                  "  pm.expect(body.instrumentId).to.eql(66);",
                  "  pm.expect(body.side).to.eql('CASH_IN');",
                  "  pm.expect(body.type).to.eql('MARKET');",
                  "  pm.expect(body.size).to.eql(5000);",
                  "  pm.expect(body.price).to.eql(1);",
                  "  pm.expect(body.rejectionReason).to.eql(null);",
                  "});",
                  "pm.collectionVariables.set('transferOrderId', body.id);"
                ] } }
              ],
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Idempotency-Key", "value": "{{transferKey}}" }
                ],
                "body": { "mode": "raw", "raw": "{\n  \"side\": \"CASH_IN\",\n  \"amount\": 5000\n}" },
                "url": "{{baseUrl}}/api/v1/users/{{userId}}/orders"
              }
            },
            {
              "name": "Retry CASH_IN: same key, same request -> credited once",
              "event": [
                { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
                  "pm.collectionVariables.set('expectedCashDelta', '0');"
                ] } },
                { "listen": "test", "script": { "type": "text/javascript", "exec": [
                  "const body = pm.response.json();",
                  "pm.test('201 replay of the same CASH_IN', () => {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(pm.response.headers.get('Idempotent-Replayed')).to.eql('true');",
                  "  pm.expect(String(body.id)).to.eql(String(pm.collectionVariables.get('transferOrderId')));",
                  "  pm.expect(body.status).to.eql('FILLED');",
                  "});"
                ] } }
              ],
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Idempotency-Key", "value": "{{transferKey}}" }
                ],
                "body": { "mode": "raw", "raw": "{\n  \"side\": \"CASH_IN\",\n  \"amount\": 5000\n}" },
                "url": "{{baseUrl}}/api/v1/users/{{userId}}/orders"
              }
            },
            {
              "name": "Same key, different amount -> 409",
              "event": [
                { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
                  "pm.collectionVariables.set('expectedCashDelta', '0');"
                ] } },
                { "listen": "test", "script": { "type": "text/javascript", "exec": [
                  "pm.test('409 IDEMPOTENCY_KEY_REUSED', () => {",
                  "  pm.response.to.have.status(409);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.code).to.eql('IDEMPOTENCY_KEY_REUSED');",
                  "  pm.expect(body.detail).to.include('was already used for a different order request');",
                  "});"
                ] } }
              ],
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Idempotency-Key", "value": "{{transferKey}}" }
                ],
                "body": { "mode": "raw", "raw": "{\n  \"side\": \"CASH_IN\",\n  \"amount\": 6000\n}" },
                "url": "{{baseUrl}}/api/v1/users/{{userId}}/orders"
              }
            },
            {
              "name": "CASH_OUT 3000 -> FILLED (debits the cash)",
              "event": [
                { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
                  "// New key: a new intention. The CASH_IN of 5,000 above guarantees the funds.",
                  "pm.collectionVariables.set('transferKey', pm.variables.replaceIn('{{$guid}}'));",
                  "pm.collectionVariables.set('expectedCashDelta', '-3000');"
                ] } },
                { "listen": "test", "script": { "type": "text/javascript", "exec": [
                  "const body = pm.response.json();",
                  "pm.test('201 FILLED CASH_OUT of 3000, not a replay', () => {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(pm.response.headers.has('Idempotent-Replayed')).to.be.false;",
                  "  pm.expect(body.status).to.eql('FILLED');",
                  "  pm.expect(body.side).to.eql('CASH_OUT');",
                  "  pm.expect(body.size).to.eql(3000);",
                  "  pm.expect(body.price).to.eql(1);",
                  "  pm.expect(body.rejectionReason).to.eql(null);",
                  "});",
                  "pm.collectionVariables.set('transferOrderId', body.id);"
                ] } }
              ],
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Idempotency-Key", "value": "{{transferKey}}" }
                ],
                "body": { "mode": "raw", "raw": "{\n  \"side\": \"CASH_OUT\",\n  \"amount\": 3000\n}" },
                "url": "{{baseUrl}}/api/v1/users/{{userId}}/orders"
              }
            },
            {
              "name": "Retry CASH_OUT: same key, same request -> debited once",
              "event": [
                { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
                  "pm.collectionVariables.set('expectedCashDelta', '0');"
                ] } },
                { "listen": "test", "script": { "type": "text/javascript", "exec": [
                  "const body = pm.response.json();",
                  "pm.test('201 replay of the same CASH_OUT', () => {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(pm.response.headers.get('Idempotent-Replayed')).to.eql('true');",
                  "  pm.expect(String(body.id)).to.eql(String(pm.collectionVariables.get('transferOrderId')));",
                  "  pm.expect(body.status).to.eql('FILLED');",
                  "});"
                ] } }
              ],
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Idempotency-Key", "value": "{{transferKey}}" }
                ],
                "body": { "mode": "raw", "raw": "{\n  \"side\": \"CASH_OUT\",\n  \"amount\": 3000\n}" },
                "url": "{{baseUrl}}/api/v1/users/{{userId}}/orders"
              }
            },
            {
              "name": "CASH_OUT above the available cash -> REJECTED",
              "event": [
                { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
                  "// One peso more than can be withdrawn right now (cash minus NEW BUY reservations), whatever the state.",
                  "pm.collectionVariables.set('cashOutTooMuch', String(Math.floor(Number(pm.collectionVariables.get('availableCashBefore'))) + 1));",
                  "pm.collectionVariables.set('expectedCashDelta', '0');"
                ] } },
                { "listen": "test", "script": { "type": "text/javascript", "exec": [
                  "const body = pm.response.json();",
                  "pm.test('201 REJECTED INSUFFICIENT_FUNDS (persisted business result)', () => {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(body.status).to.eql('REJECTED');",
                  "  pm.expect(body.rejectionReason).to.eql('INSUFFICIENT_FUNDS');",
                  "  pm.expect(body.side).to.eql('CASH_OUT');",
                  "  pm.expect(body.size).to.eql(Number(pm.collectionVariables.get('cashOutTooMuch')));",
                  "});"
                ] } }
              ],
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Idempotency-Key", "value": "{{requestKey}}" }
                ],
                "body": { "mode": "raw", "raw": "{\n  \"side\": \"CASH_OUT\",\n  \"amount\": {{cashOutTooMuch}}\n}" },
                "url": "{{baseUrl}}/api/v1/users/{{userId}}/orders"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Idempotency (run in order)",
      "item": [
        {
          "name": "Create with a fixed key",
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
              "pm.collectionVariables.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}'));"
            ] } },
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('201, not a replay', () => {",
              "  pm.response.to.have.status(201);",
              "  pm.expect(pm.response.headers.has('Idempotent-Replayed')).to.be.false;",
              "});",
              "pm.collectionVariables.set('orderId', pm.response.json().id);"
            ] } }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"instrumentId\": {{instrumentId}},\n  \"side\": \"BUY\",\n  \"type\": \"LIMIT\",\n  \"quantity\": 1,\n  \"price\": 800.00\n}" },
            "url": "{{baseUrl}}/api/v1/users/{{userId}}/orders"
          }
        },
        {
          "name": "Retry: same key, same request -> original result",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('201 replay of the same order, nothing new placed', () => {",
              "  pm.response.to.have.status(201);",
              "  pm.expect(pm.response.headers.get('Idempotent-Replayed')).to.eql('true');",
              "  pm.expect(String(pm.response.json().id)).to.eql(String(pm.collectionVariables.get('orderId')));",
              "});"
            ] } }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"price\": 800,\n  \"quantity\": 1,\n  \"type\": \"LIMIT\",\n  \"side\": \"BUY\",\n  \"instrumentId\": {{instrumentId}}\n}" },
            "url": "{{baseUrl}}/api/v1/users/{{userId}}/orders",
            "description": "Same intention written differently (800 vs 800.00, other field order): still a replay."
          }
        },
        {
          "name": "Same key, different request -> 409",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('409 IDEMPOTENCY_KEY_REUSED', () => {",
              "  pm.response.to.have.status(409);",
              "  pm.expect(pm.response.json().code).to.eql('IDEMPOTENCY_KEY_REUSED');",
              "});"
            ] } }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"instrumentId\": {{instrumentId}},\n  \"side\": \"BUY\",\n  \"type\": \"LIMIT\",\n  \"quantity\": 2,\n  \"price\": 800.00\n}" },
            "url": "{{baseUrl}}/api/v1/users/{{userId}}/orders"
          }
        }
      ]
    },
    {
      "name": "6. Orders - cancel",
      "item": [
        {
          "name": "Cancel the NEW limit order -> CANCELLED",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('200 CANCELLED (reservation released)', () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().status).to.eql('CANCELLED');",
              "});"
            ] } }
          ],
          "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/users/{{userId}}/orders/{{limitOrderId}}/cancel" }
        },
        {
          "name": "Cancel it again -> 409",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('409 ORDER_NOT_CANCELLABLE', () => {",
              "  pm.response.to.have.status(409);",
              "  pm.expect(pm.response.json().code).to.eql('ORDER_NOT_CANCELLABLE');",
              "});"
            ] } }
          ],
          "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/users/{{userId}}/orders/{{limitOrderId}}/cancel" }
        },
        {
          "name": "Cancel a FILLED order (seed id 1) -> 409",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('409 ORDER_NOT_CANCELLABLE', () => pm.response.to.have.status(409));"
            ] } }
          ],
          "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/users/1/orders/1/cancel" }
        },
        {
          "name": "Cancel another user's order (seed id 7 as user 2) -> 404",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('404 ORDER_NOT_FOUND', () => {",
              "  pm.response.to.have.status(404);",
              "  pm.expect(pm.response.json().code).to.eql('ORDER_NOT_FOUND');",
              "});"
            ] } }
          ],
          "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/users/2/orders/7/cancel" }
        }
      ]
    }
  ]
}
